# pixel_fifo.tcl - generated by scripts/tools/xci2tcl.tcl from the project-mode pixel_fifo.xci (xilinx.com:ip:fifo_generator:13.2).
# Only values that differ from the IP defaults are listed. Expects ::IP_NAME, ::IP_DIR (and ::SRC1 for COE paths).
create_ip -name fifo_generator -vendor xilinx.com -library ip -version 13.2 -module_name $::IP_NAME -dir $::IP_DIR
set_property -dict [list \
    CONFIG.Almost_Full_Flag                          {true} \
    CONFIG.Data_Count_Width                          {9} \
    CONFIG.Dout_Reset_Value                          {FFFFFFFF} \
    CONFIG.Enable_Safety_Circuit                     {true} \
    CONFIG.Fifo_Implementation                       {Independent_Clocks_Block_RAM} \
    CONFIG.Full_Flags_Reset_Value                    {1} \
    CONFIG.Input_Data_Width                          {128} \
    CONFIG.Input_Depth                               {512} \
    CONFIG.Output_Data_Width                         {32} \
    CONFIG.Output_Depth                              {2048} \
    CONFIG.Output_Register_Type                      {Both} \
    CONFIG.Overflow_Flag                             {true} \
    CONFIG.Performance_Options                       {First_Word_Fall_Through} \
    CONFIG.Programmable_Empty_Type                   {Single_Programmable_Empty_Threshold_Constant} \
    CONFIG.Programmable_Full_Type                    {Single_Programmable_Full_Threshold_Constant} \
    CONFIG.Read_Data_Count_Width                     {12} \
    CONFIG.Reset_Type                                {Asynchronous_Reset} \
    CONFIG.Underflow_Flag                            {true} \
    CONFIG.Use_Embedded_Registers                    {true} \
    CONFIG.Use_Extra_Logic                           {true} \
    CONFIG.Valid_Flag                                {true} \
    CONFIG.Write_Acknowledge_Flag                    {true} \
    CONFIG.synchronization_stages                    {8} \
] [get_ips $::IP_NAME]

# Thresholds for the PixelFeeder FIFO (128-bit write x 512, 32-bit read x 2048).
# prog_full 448/447 (write side): PixelFeeder only issues a DDR read while prog_full is low and at
#   most 32 beats are outstanding, so 448 + 32 (+ flag latency) < 512 and no beat is ever dropped.
#   (The old .xci had 500, which left 12 entries for up to 32+ in-flight beats.)
# prog_empty 1600/1601 (read side, 32-bit words): the "start level" before video is offered. It must
#   be reachable below prog_full (448*4 = 1792 words); the old 1900 never would be once throttled.
set_property -dict [list \
    CONFIG.Full_Threshold_Assert_Value  {448} \
    CONFIG.Full_Threshold_Negate_Value  {447} \
    CONFIG.Empty_Threshold_Assert_Value {1600} \
    CONFIG.Empty_Threshold_Negate_Value {1601} \
] [get_ips $::IP_NAME]
