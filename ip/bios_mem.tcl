# bios_mem.tcl - generated by scripts/tools/xci2tcl.tcl from the project-mode bios_mem.xci (xilinx.com:ip:blk_mem_gen:8.4).
# Only values that differ from the IP defaults are listed. Expects ::IP_NAME, ::IP_DIR (and ::SRC1 for COE paths).
create_ip -name blk_mem_gen -vendor xilinx.com -library ip -version 8.4 -module_name $::IP_NAME -dir $::IP_DIR
set_property -dict [list \
    CONFIG.Algorithm                                 {Fixed_Primitives} \
    CONFIG.Assume_Synchronous_Clk                    {true} \
    CONFIG.Coe_File                                  "$::ROOT/sw/gios.inst.coe" \
    CONFIG.Enable_B                                  {Use_ENB_Pin} \
    CONFIG.Fill_Remaining_Memory_Locations           {true} \
    CONFIG.Load_Init_File                            {true} \
    CONFIG.Memory_Type                               {Dual_Port_ROM} \
    CONFIG.Port_A_Write_Rate                         {0} \
    CONFIG.Port_B_Clock                              {100} \
    CONFIG.Port_B_Enable_Rate                        {100} \
    CONFIG.Read_Width_A                              {32} \
    CONFIG.Read_Width_B                              {32} \
    CONFIG.Register_PortA_Output_of_Memory_Primitives {false} \
    CONFIG.Write_Depth_A                             {4096} \
    CONFIG.Write_Width_A                             {32} \
    CONFIG.Write_Width_B                             {32} \
    CONFIG.Register_PortB_Output_of_Memory_Primitives {false} \
] [get_ips $::IP_NAME]
