# mig_rdf.tcl - generated by scripts/tools/xci2tcl.tcl from the project-mode mig_rdf.xci (xilinx.com:ip:fifo_generator:13.2).
# Only values that differ from the IP defaults are listed. Expects ::IP_NAME, ::IP_DIR (and ::SRC1 for COE paths).
create_ip -name fifo_generator -vendor xilinx.com -library ip -version 13.2 -module_name $::IP_NAME -dir $::IP_DIR
set_property -dict [list \
    CONFIG.Data_Count_Width                          {9} \
    CONFIG.Empty_Threshold_Assert_Value              {6} \
    CONFIG.Empty_Threshold_Negate_Value              {7} \
    CONFIG.Fifo_Implementation                       {Independent_Clocks_Builtin_FIFO} \
    CONFIG.Input_Data_Width                          {128} \
    CONFIG.Input_Depth                               {512} \
    CONFIG.Output_Data_Width                         {128} \
    CONFIG.Output_Depth                              {512} \
    CONFIG.Performance_Options                       {First_Word_Fall_Through} \
    CONFIG.READ_CLK.FREQ_HZ                          {50000000} \
    CONFIG.Read_Clock_Frequency                      {50} \
    CONFIG.Read_Data_Count_Width                     {9} \
    CONFIG.Reset_Type                                {Asynchronous_Reset} \
    CONFIG.Underflow_Flag                            {true} \
    CONFIG.Use_Dout_Reset                            {false} \
    CONFIG.Valid_Flag                                {true} \
    CONFIG.WRITE_CLK.FREQ_HZ                         {152000000} \
    CONFIG.Write_Acknowledge_Flag                    {true} \
    CONFIG.Write_Clock_Frequency                     {152} \
    CONFIG.Write_Data_Count_Width                    {9} \
] [get_ips $::IP_NAME]

# mig_rdf gets a prog_full flag: MigUiAdapter only issues a MIG read while prog_full is low and
# fewer than MAX_INFLIGHT (32) beats are outstanding, so 400 + 32 (+ flag latency) < 512 entries
# and a returning beat always has room. MIG read data cannot be back-pressured.
set_property -dict [list \
    CONFIG.Programmable_Full_Type      {Single_Programmable_Full_Threshold_Constant} \
    CONFIG.Full_Threshold_Assert_Value {400} \
] [get_ips $::IP_NAME]
