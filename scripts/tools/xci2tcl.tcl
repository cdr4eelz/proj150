# xci2tcl.tcl - one-off developer tool: turn a Vivado-GUI-made .xci into a create_ip Tcl script.
#
#   vivado -mode batch -nojournal -source scripts/tools/xci2tcl.tcl -tclargs <in.xci> <out.tcl> [board_part]
#
# Creates the same IP fresh with create_ip, keeps only the CONFIG.* values that differ from a fresh
# IP's defaults, writes them as ONE set_property -dict (settings depend on each other, so they
# must be applied atomically), and finally compares the recreated IP with the .xci and reports any
# CONFIG.* mismatch. COE paths (relative to the .xci) are emitted relative to $::SRC1
# (= proj150.srcs/sources_1), which the build defines.
# Not used by the build; kept so the scripted IP sources can be re-derived from a GUI session.
lassign $argv in_xci out_tcl board
create_project -in_memory -part xc7a100tcsg324-1
if {$board ne ""} { set_property board_part $board [current_project] }
set name [file rootname [file tail $in_xci]]
file delete -force /tmp/xci2tcl_$name
file mkdir /tmp/xci2tcl_$name
read_ip $in_xci
set orig [get_ips $name]
set vlnv [get_property IPDEF $orig]
lassign [split $vlnv :] vendor lib ipname ver
create_ip -vendor $vendor -library $lib -name $ipname -version $ver -module_name fresh_$name -dir /tmp/xci2tcl_$name
set fresh [get_ips fresh_$name]
set diff {}
foreach p [lsort [list_property $orig CONFIG.*]] {
    if {[string match *INSERT_VIP $p]} continue    ;# clk_wiz interface property, not settable from Tcl
    set v [get_property $p $orig]
    if {[catch {get_property $p $fresh} dv] || $dv ne $v} { lappend diff $p $v }
}
set xdir [file dirname [file normalize $in_xci]]
set emit {}; set apply {}
foreach {p v} $diff {
    if {$p eq "CONFIG.Component_Name"} continue
    set ev $v; set av $v
    if {$p eq "CONFIG.Coe_File" && [string match ../../* $v]} {
        set av [file normalize [file join $xdir $v]]
        set ev "\$::SRC1/[string range $v 6 end]"
    }
    lappend emit $p $ev; lappend apply $p $av
}
create_ip -vendor $vendor -library $lib -name $ipname -version $ver -module_name new_$name -dir /tmp/xci2tcl_$name
set new [get_ips new_$name]
set_property -dict $apply $new
# values that equal the fresh default but change once other settings are applied must be listed too
for {set pass 0} {$pass < 3} {incr pass} {
    set more {}
    foreach p [list_property $orig CONFIG.*] {
        if {$p eq "CONFIG.Component_Name" || $p eq "CONFIG.Coe_File" || [string match *INSERT_VIP $p]} continue
        if {[get_property $p $orig] ne [get_property $p $new] && [lsearch -exact $emit $p] < 0} {
            lappend more $p [get_property $p $orig]
        }
    }
    if {![llength $more]} break
    lappend emit {*}$more; lappend apply {*}$more
    set_property -dict $more $new
}
set fh [open $out_tcl w]
puts $fh "# $name.tcl - generated by scripts/tools/xci2tcl.tcl from the project-mode $name.xci ($vlnv)."
puts $fh "# Only values that differ from the IP defaults are listed. Expects ::IP_NAME, ::IP_DIR, ::SRC1."
puts $fh "create_ip -name $ipname -vendor $vendor -library $lib -version $ver -module_name \$::IP_NAME -dir \$::IP_DIR"
puts $fh "set_property -dict \[list \\"
foreach {p v} $emit {
    if {[string match {$::SRC1*} $v]} { set q "\"$v\"" } else { set q "{$v}" }
    puts $fh [format "    %-48s %s \\" $p $q]
}
puts $fh "\] \[get_ips \$::IP_NAME\]"
close $fh
set mism 0
foreach p [list_property $orig CONFIG.*] {
    if {$p eq "CONFIG.Component_Name" || [string match *INSERT_VIP $p]} continue
    set a [get_property $p $orig]; set b [get_property $p $new]
    if {$p eq "CONFIG.Coe_File" && [string match ../../* $a]} { set a [file normalize [file join $xdir $a]]; set b [file normalize [file join $xdir $b]] }
    if {$a ne $b} { incr mism; puts "MISMATCH $p: xci=$a new=$b" }
}
puts "XCI2TCL $name: [expr {[llength $emit]/2}] settings written, $mism mismatches vs the xci"
