!/proj150.srcs/sources_1/ip/*/*.xml

/proj150.cache/
/proj150.hw/
/proj150.ip_user_files/
/proj150.runs/
/proj150.sim/
/icarus/

#Try to match temp/cache directories
.Xil/
**/.Xil/

**/*.jou
**/*.log
vivado_*.zip
vivado_*.str

.DS_Store
**/.DS_Store


